# Copy to infrastructure/.env.prod and fill in before:
#   docker compose -f infrastructure/docker-compose.prod.yml --env-file infrastructure/.env.prod up -d --build

# Public hostname or IP users open in the browser (no scheme).
PUBLIC_HOST=your.server.ip.or.domain
# Same public IP for coturn (required). Often identical to PUBLIC_HOST if using an IP.
EXTERNAL_IP=your.server.public.ip

HTTP_PORT=80

POSTGRES_USER=hc
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=human_conversation

# Supabase (same project as local)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-legacy-jwt-secret
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

DEV_AUTH=false
AUTO_APPROVE_LISTENERS=false
ADMIN_API_KEY=change-me-admin-key

TURN_USERNAME=hc
TURN_PASSWORD=change-me-turn-password
STUN_URLS=stun:stun.l.google.com:19302
