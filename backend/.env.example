HTTP_ADDR=:8081
# Fly/PaaS: leave HTTP_ADDR unset and they provide PORT.
DATABASE_URL=postgres://hc:hc@localhost:5433/human_conversation?sslmode=disable

# Supabase project URL — required for ES256 access-token verification (JWKS).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Legacy JWT secret (HS256 / DEV_AUTH). Project Settings → JWT Keys → Legacy JWT secret.
SUPABASE_JWT_SECRET=dev-supabase-jwt-secret-change-me
# true = allow POST /auth/dev-login (local only). Set false with real Supabase auth.
DEV_AUTH=true
# When DEV_AUTH=false but you still want local “Available” without admin approve:
# AUTO_APPROVE_LISTENERS=true

# ICE / TURN (separable from API host)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:localhost:3478
TURN_USERNAME=hc
TURN_PASSWORD=hcpassword
TURN_SECRET=
TURN_CREDENTIAL_TTL_SEC=3600
# Optional: force TURN host for phones (LAN IP). Empty = rewrite from request Host.
# TURN_PUBLIC_HOST=192.168.1.10

# Razorpay (optional in dev — mock purchase works when empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

ADMIN_API_KEY=dev-admin-key

# Credits: 10 credits = 1 minute talker price by default (see pricing_config)
MEDIA_GRACE_MS=2500
ACCEPT_TIMEOUT_SEC=15
LEASE_TTL_SEC=30
HEARTBEAT_SWEEP_SEC=5
